{
  "name": "lcu-mcp",
  "version": "0.3.0",
  "type": "module",
  "description": "MCP server for the League of Legends client: LCU REST API, live WAMP events & recording, CDP console/DOM access, and OpenAPI schema introspection",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "lcu-mcp": "bin/lcu-mcp.js"
  },
  "main": "src/index.js",
  "files": [
    "bin",
    "src",
    "certs",
    "config",
    "LICENSE",
    "README.md",
    "PRIVACY.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "lint": "node scripts/lint.mjs",
    "smoke": "node scripts/smoke.mjs",
    "tdqs:lint": "tdqs lint --command \"node bin/lcu-mcp.js\"",
    "tdqs:score": "node --env-file=.env ./node_modules/mcp-tdqs/dist/cli.js score --command \"node bin/lcu-mcp.js\" --concurrency 1",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Triggered0/lcu-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Triggered0/lcu-mcp/issues"
  },
  "homepage": "https://github.com/Triggered0/lcu-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "league-of-legends",
    "lcu",
    "riot-games",
    "cdp"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "mcp-tdqs": "^0.2.0"
  }
}
